---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Kart from '../components/Kart.astro';
import Ikon from '../components/Ikon.astro';
import { KATEGORI_BILGI, type Kategori } from '../content.config';
import { webSitesiSemasi } from '../lib/sema';

const tarih = (r: { data: { yayin: Date; guncelleme?: Date } }) => r.data.guncelleme ?? r.data.yayin;
const hepsi = (await getCollection('rehber')).sort((a, b) => tarih(b).getTime() - tarih(a).getTime());
// Manşet: temel çalışma prensibi yazısı; yoksa en yeni yazı
const one = hepsi.find((r) => r.id === 'isitmali-tutun-cihazlari-nasil-calisir') ?? hepsi[0];
const yan = hepsi.filter((r) => r !== one).slice(0, 4);
const son = hepsi.filter((r) => r !== one && !yan.includes(r)).slice(0, 6);
const kategoriler = (Object.keys(KATEGORI_BILGI) as Kategori[]).map((k) => ({ k, ...KATEGORI_BILGI[k], yazilar: hepsi.filter((r) => r.data.kategori === k) }));
const kaynakSayisi = new Set(hepsi.flatMap((r) => r.data.kaynaklar.map((k) => k.url))).size;
const sss = hepsi.find((r) => r.id === 'isitmali-tutun-sik-sorulan-sorular');
---
<Base title="Isıtmalı tütün cihazları için bağımsız teknik rehber" description="IQOS, glo, Ploom ve lil cihazlarının nasıl çalıştığı, hangi çubukla uyumlu olduğu, bakımı ve Türkiye'deki mevzuat. Satış yapmayan, kaynak gösteren rehber." jsonLd={[webSitesiSemasi()]}>
  <section class="giris">
    <div class="kap giris-izgara">
      <div>
        <p class="ust-etiket">Bağımsız teknik başvuru kaynağı</p>
        <h1>Isıtmalı tütün cihazları hakkında <em>kaynağıyla</em> doğru bilgi</h1>
        <p class="giris-ozet">Cihazlar nasıl çalışır, hangi çubuk hangi cihazda kullanılır, nasıl bakılır, kurallar neler? Her bilgi üreticinin kılavuzuna ya da resmi kaynağa dayanır. Satış yapmıyor, ürün önermiyoruz.</p>
        <div class="dugmeler">
          <a href="/rehber/" class="dugme dugme-ana">Rehberlere göz at <Ikon ad="ok" boyut={18} /></a>
          {sss && <a href={`/rehber/${sss.id}/`} class="dugme">Sık sorulan sorular</a>}
        </div>
      </div>
      <dl class="sayilar">
        <div><dt>Rehber</dt><dd>{hepsi.length}</dd></div>
        <div><dt>Kategori</dt><dd>{kategoriler.length}</dd></div>
        <div><dt>Kaynak</dt><dd>{kaynakSayisi}</dd></div>
        <div><dt>Satış ve reklam</dt><dd>0</dd></div>
      </dl>
    </div>
  </section>

  <div class="kap sayfa">
    {one && (
      <section class="manset" aria-labelledby="one-cikan">
        <div>
          <div class="bolum-baslik"><h2 id="one-cikan">Öne çıkan</h2></div>
          <Kart slug={one.id} gorsel={one.data.gorsel} baslik={one.data.baslik} aciklama={one.data.aciklama} kategori={one.data.kategori} tarih={tarih(one)} tur="buyuk" />
        </div>
        <div>
          <div class="bolum-baslik"><h2>Son güncellenenler</h2><a href="/rehber/" class="tumu">Tümü</a></div>
          <div class="manset-yan">{yan.map((r) => <Kart slug={r.id} baslik={r.data.baslik} kategori={r.data.kategori} tarih={tarih(r)} tur="yatay" />)}</div>
        </div>
      </section>
    )}

    <section class="bolum-ana" aria-labelledby="kategoriler">
      <div class="bolum-baslik"><h2 id="kategoriler">Konulara göre</h2></div>
      <div class="kat-izgara">
        {kategoriler.map((k) => (
          <a href={`/kategori/${k.k}/`} class="kat-kart" style={`--kat:${k.renk}`}>
            <span class="kat-kart-ikon"><Ikon ad={k.k} boyut={22} /></span>
            <span class="kat-kart-ad">{k.kisa}</span>
            <span class="kat-kart-aciklama">{k.aciklama}</span>
            <span class="kat-kart-sayi">{k.yazilar.length} rehber <Ikon ad="ok" boyut={14} /></span>
          </a>
        ))}
      </div>
    </section>

    {son.length > 0 && (
      <section class="bolum-ana" aria-labelledby="diger">
        <div class="bolum-baslik"><h2 id="diger">Diğer rehberler</h2><a href="/rehber/" class="tumu">Tüm rehberler</a></div>
        <div class="izgara">{son.map((r) => <Kart slug={r.id} gorsel={r.data.gorsel} baslik={r.data.baslik} aciklama={r.data.aciklama} kategori={r.data.kategori} tarih={tarih(r)} />)}</div>
      </section>
    )}

    <section class="ilkeler" aria-labelledby="ilkeler">
      <h2 id="ilkeler" class="gizli">Yayın ilkelerimiz</h2>
      <div><Ikon ad="kaynak" boyut={22} /><h3>Her bilgi kaynaklı</h3><p>Rehberlerin sonunda üretici kılavuzları ve resmi metinler listelenir. Doğrulanamayan bilgi yazılmaz.</p></div>
      <div><Ikon ad="kalkan" boyut={22} /><h3>Markadan bağımsız</h3><p>IQOS, glo, Ploom ve lil'i aynı ölçütle anlatırız. Hiçbir markayı önermeyiz.</p></div>
      <div><Ikon ad="kitap" boyut={22} /><h3>Satış ve reklam yok</h3><p>Fiyat, satış bağlantısı ya da sponsorlu içerik yayımlamayız. <a href="/yayin-ilkeleri/">Yayın ilkelerimiz</a></p></div>
    </section>
  </div>
</Base>
