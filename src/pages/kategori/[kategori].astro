---
import { yayindakiRehberler } from '../../lib/rehberler';
import Base from '../../layouts/Base.astro';
import Kirinti from '../../components/Kirinti.astro';
import Kart from '../../components/Kart.astro';
import Ikon from '../../components/Ikon.astro';
import MarkaSuzgec from '../../components/MarkaSuzgec.astro';
import { KATEGORI_BILGI, KATEGORILER, type Kategori } from '../../content.config';
import { MARKALAR, rehberMarkalari } from '../../lib/markalar';
import { okumaSuresi } from '../../lib/site';
import { mutlakUrl } from '../../lib/sema';

export function getStaticPaths() {
  return (Object.keys(KATEGORI_BILGI) as Kategori[]).map((kategori) => ({ params: { kategori } }));
}
const kategori = Astro.params.kategori as Kategori;
const bilgi = KATEGORI_BILGI[kategori];
const tarih = (r: { data: { yayin: Date; guncelleme?: Date } }) => r.data.guncelleme ?? r.data.yayin;
const yazilar = (await yayindakiRehberler((r) => r.data.kategori === kategori)).sort((a, b) => tarih(b).getTime() - tarih(a).getTime());
const sayilar = Object.fromEntries(MARKALAR.map((m) => [m.slug, yazilar.filter((r) => rehberMarkalari(r.data).includes(m.slug)).length]));
const kart = (r: (typeof yazilar)[number]) => ({ slug: r.id, gorsel: r.data.gorsel, baslik: r.data.baslik, etiketler: r.data.etiketler, aciklama: r.data.aciklama, kategori, tarih: tarih(r), dakika: okumaSuresi(r.body) });
// İlk yazı manşet olarak büyük gösterilir; süzgeç kullanılınca manşet de diğer kartlar gibi süzülür
const [manset, ...kalan] = yazilar;
// CollectionPage + ItemList: yalnızca indekslenen (taslak olmayan) rehberler
const sema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: bilgi.seoBaslik,
  description: bilgi.seoAciklama,
  url: mutlakUrl(`/kategori/${kategori}/`),
  inLanguage: 'tr-TR',
  isPartOf: { '@id': mutlakUrl('/#websitesi') },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: yazilar.filter((r) => !r.data.dogrulanacak).map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: mutlakUrl(`/rehber/${r.id}/`), name: r.data.baslik })),
  },
};
---
<Base title={bilgi.seoBaslik} description={bilgi.seoAciklama} noindex={yazilar.length === 0} jsonLd={[sema]}>
  <div class="kap sayfa" style={`--kat:${bilgi.renk}`}>
    <Kirinti yollar={[{ ad: bilgi.kisa, href: `/kategori/${kategori}/` }]} />
    <header class="kat-ust">
      <span class="kat-kart-ikon"><Ikon ad={kategori} boyut={24} /></span>
      <h1>{KATEGORILER[kategori]}</h1>
      <p class="ozet">{bilgi.aciklama} {yazilar.length} rehber.</p>
      <MarkaSuzgec sayilar={sayilar} />
    </header>
    {yazilar.length > 0
      ? <><h2 class="gizli">Bu kategorideki rehberler</h2>
          <div class="kat-manset" data-suzgec-bolum><Kart {...kart(manset)} tur="buyuk" /></div>
          {kalan.length > 0 && <div class="izgara" data-suzgec-bolum>{kalan.map((r) => <Kart {...kart(r)} />)}</div>}</>
      : <p class="bos">Bu kategoride henüz rehber yok. <a href="/rehber/">Tüm rehberlere</a> göz atın.</p>}
  </div>
</Base>
