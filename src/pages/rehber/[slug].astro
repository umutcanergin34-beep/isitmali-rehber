---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kirinti from '../../components/Kirinti.astro';
import SSS from '../../components/SSS.astro';
import Kapak from '../../components/Kapak.astro';
import Kart from '../../components/Kart.astro';
import Ikon from '../../components/Ikon.astro';
import { KATEGORILER, KATEGORI_BILGI } from '../../content.config';
import { sssSemasi, makaleSemasi } from '../../lib/sema';
import { tarihYaz, isoGun, okumaSuresi, EDITOR, SITE_ADI } from '../../lib/site';

export async function getStaticPaths() {
  const rehberler = await getCollection('rehber');
  return rehberler.map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const v = r.data;
const { Content, headings } = await render(r);
const bolumler = headings.filter((h) => h.depth === 2);
const dakika = okumaSuresi(r.body);
const alanAdi = (u: string) => new URL(u).hostname.replace(/^www\./, '');
// İlgili rehberler: ortak etiket (x3) + aynı kategori (x2); eşitlikte sayfaya özgü karışık sıra.
// Taslaklar (noindex) önerilmez. Alfabetik sıra her sayfada aynı 3 yazıyı öne çıkarıyordu.
const etiket = (x: string[]) => new Set(x.map((e) => e.toLocaleLowerCase('tr')));
const benim = etiket(v.etiketler);
const karis = (a: string) => [...a].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const tumu = (await getCollection('rehber', (x) => !x.data.dogrulanacak)).filter((x) => x.id !== r.id);
const puan = (x: (typeof tumu)[number]) => [...etiket(x.data.etiketler)].filter((e) => benim.has(e)).length * 3 + (x.data.kategori === v.kategori ? 2 : 0);
const digerleri = tumu
  .map((x) => ({ x, p: puan(x), k: karis(r.id + x.id) }))
  .sort((a, b) => b.p - a.p || a.k - b.k)
  .slice(0, 3)
  .map((o) => o.x);
// Paylaşım ve Article şeması için 1200 px görseller (16:9, 4:3, 1:1)
const oranlar = [[1200, 675], [1200, 900], [1200, 1200]] as const;
const ogResimler = v.gorsel
  ? await Promise.all(oranlar.map(([width, height]) => getImage({ src: v.gorsel!.src, width, height, fit: 'cover', format: 'jpg', quality: 80 })))
  : [];
const ogGorsel = ogResimler[0] ? { src: ogResimler[0].src, width: 1200, height: 675, alt: v.gorsel!.alt } : undefined;
const kat = KATEGORI_BILGI[v.kategori];
// Yan sütun: aynı konudaki en yeni dört rehber (ilgili rehberlerde çıkanlar hariç)
const konudaki = tumu.filter((x) => x.data.kategori === v.kategori && !digerleri.includes(x))
  .sort((a, b) => (b.data.guncelleme ?? b.data.yayin).getTime() - (a.data.guncelleme ?? a.data.yayin).getTime())
  .slice(0, 4);
---
<Base title={v.seoBaslik ?? v.baslik} description={v.aciklama} ogTur="article" yayin={v.yayin} guncelleme={v.guncelleme} noindex={v.dogrulanacak} ogGorsel={ogGorsel}
  jsonLd={[makaleSemasi(r.id, v, ogResimler.map((o) => o.src)), sssSemasi(v.sss)].filter(Boolean) as Record<string, unknown>[]}>
  <div class="okuma-cubugu" aria-hidden="true" data-okuma></div>
  <div class="kap" style={`--kat:${kat.renk}`}>
    <header class="yazi-ust">
      <Kirinti yollar={[{ ad: kat.kisa, href: `/kategori/${v.kategori}/` }, { ad: v.baslik, href: `/rehber/${r.id}/` }]} />
      <a href={`/kategori/${v.kategori}/`} class="kat-etiket"><Ikon ad={v.kategori} boyut={14} />{KATEGORILER[v.kategori]}</a>
      <h1>{v.baslik}</h1>
      <p class="yazi-dek">{v.aciklama}</p>
      <div class="imza">
        <span class="imza-foto" aria-hidden="true"><Ikon ad={EDITOR.ad ? 'kisi' : 'kitap'} boyut={20} /></span>
        <div class="imza-metin">
          <p class="imza-ad">{EDITOR.ad ? <a href="/hakkimizda/#editor">{EDITOR.ad}</a> : <a href="/hakkimizda/">{SITE_ADI} editörlüğü</a>}</p>
          <p class="imza-alt"><Ikon ad="onay" boyut={14} />{v.kaynaklar.length} kaynakla kontrol edildi · <a href="/yayin-ilkeleri/">Yayın ilkeleri</a></p>
        </div>
        <ul class="meta">
          <li>Güncelleme: <time datetime={isoGun(v.guncelleme ?? v.yayin)}>{tarihYaz(v.guncelleme ?? v.yayin)}</time></li>
          <li><Ikon ad="saat" boyut={15} />{dakika} dk okuma</li>
        </ul>
      </div>
      {v.dogrulanacak && <p class="uyari">Taslak: bu sayfadaki bazı bilgiler yayından önce resmi kaynaktan doğrulanacak.</p>}
    </header>
    <div class="yazi-duzen">
      <article class="yazi">
        {v.gorsel && <figure class="yazi-kapak"><Kapak kategori={v.kategori} buyuk oncelikli gorsel={v.gorsel} />{v.gorsel.kaynak && <figcaption>Fotoğraf: {v.gorsel.kaynakUrl ? <a href={v.gorsel.kaynakUrl} rel="nofollow noopener" target="_blank">{v.gorsel.kaynak}</a> : v.gorsel.kaynak}</figcaption>}</figure>}
        {bolumler.length > 1 && (
          <details class="icindekiler-mobil">
            <summary>Bu rehberde · {bolumler.length} bölüm</summary>
            <ol>{bolumler.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}
        <div class="icerik"><Content /></div>
        <p class="not18"><Ikon ad="kalkan" boyut={16} />Bu sayfa bilgilendirme amaçlıdır, satış yapmaz ve bir ürünü önermez. Isıtmalı tütün ürünleri yalnızca 18 yaş üstü yetişkinler içindir, sağlık riski taşır ve bağımlılık yapar.</p>
        <SSS sorular={v.sss} />
        {v.kaynaklar.length > 0 && (
          <section class="bolum kaynaklar" id="kaynaklar">
            <h2>Kaynaklar</h2>
            <ol>{v.kaynaklar.map((k) => <li><a href={k.url} rel="nofollow noopener" target="_blank">{k.ad}</a><span>{alanAdi(k.url)}</span></li>)}</ol>
          </section>
        )}
      </article>
      <aside class="yazi-yan">
        {bolumler.length > 1 && (
          <nav class="icindekiler" aria-label="İçindekiler">
            <p class="yan-baslik">Bu rehberde</p>
            <ul>{bolumler.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}
        <div class="yan-kutu yan-guven">
          <p class="yan-baslik">Bu rehber hakkında</p>
          <ul>
            <li><Ikon ad="kaynak" boyut={15} />{v.kaynaklar.length} kaynağa dayanır</li>
            <li><Ikon ad="kalkan" boyut={15} />Markadan bağımsız, satış yok</li>
            <li><Ikon ad="saat" boyut={15} />İlk yayın: {tarihYaz(v.yayin)}</li>
          </ul>
          <a href="/yayin-ilkeleri/">Nasıl çalışıyoruz?</a>
        </div>
        {konudaki.length > 0 && (
          <nav class="yan-kutu yan-liste" aria-label={`${kat.kisa} konusundaki diğer rehberler`}>
            <p class="yan-baslik">{kat.kisa} konusunda</p>
            <ul>{konudaki.map((x) => <li><a href={`/rehber/${x.id}/`}>{x.data.baslik}</a></li>)}</ul>
            <a href={`/kategori/${v.kategori}/`} class="tumu">Tümü</a>
          </nav>
        )}
      </aside>
    </div>
    {digerleri.length > 0 && (
      <section class="bolum-ana ilgili">
        <div class="bolum-baslik"><h2>Bunları da okuyun</h2><a href="/rehber/" class="tumu">Tüm rehberler</a></div>
        <div class="izgara">{digerleri.map((x) => <Kart slug={x.id} gorsel={x.data.gorsel} baslik={x.data.baslik} kategori={x.data.kategori} tarih={x.data.guncelleme ?? x.data.yayin} dakika={okumaSuresi(x.body)} />)}</div>
      </section>
    )}
  </div>
</Base>

<script>
  // Okuma ilerleme çubuğu: yazı gövdesinin ne kadarının geçildiği
  const cubuk = document.querySelector<HTMLElement>('[data-okuma]');
  const yazi = document.querySelector<HTMLElement>('.yazi');
  if (cubuk && yazi) {
    let bekliyor = false;
    const guncelle = () => {
      const k = yazi.getBoundingClientRect();
      const oran = Math.min(1, Math.max(0, -k.top / Math.max(1, k.height - innerHeight)));
      cubuk.style.transform = `scaleX(${oran})`;
      bekliyor = false;
    };
    addEventListener('scroll', () => { if (!bekliyor) { bekliyor = true; requestAnimationFrame(guncelle); } }, { passive: true });
    guncelle();
  }
  // İçindekiler: ekranın üst üçte birindeki bölümün bağlantısı işaretlenir
  const baglar = [...document.querySelectorAll<HTMLAnchorElement>('.icindekiler a')];
  const bolumler = baglar.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((b): b is HTMLElement => Boolean(b));
  if (bolumler.length && 'IntersectionObserver' in window) {
    const gozcu = new IntersectionObserver((girdiler) => {
      for (const g of girdiler) if (g.isIntersecting) baglar.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${g.target.id}`));
    }, { rootMargin: '-80px 0px -66% 0px' });
    bolumler.forEach((b) => gozcu.observe(b));
  }
</script>
