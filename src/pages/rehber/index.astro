---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kirinti from '../../components/Kirinti.astro';
import Kart from '../../components/Kart.astro';

const rehberler = (await getCollection('rehber')).sort((a, b) => b.data.yayin.getTime() - a.data.yayin.getTime());
---
<Base title="Tüm rehberler" description="Isıtmalı tütün cihazlarının çalışma prensibi, uyumluluk, bakım ve mevzuatı üzerine kaynak gösteren, markadan bağımsız rehberler.">
  <div class="kap sayfa">
    <Kirinti yollar={[{ ad: 'Tüm rehberler', href: '/rehber/' }]} />
    <header class="kat-ust">
      <h1>Tüm rehberler</h1>
      <p class="ozet">Her rehber üreticilerin kendi kılavuzlarına ve resmi kaynaklara dayanır; kaynaklar sayfanın sonunda listelenir.</p>
    </header>
    <div class="izgara">{rehberler.map((r) => <Kart slug={r.id} gorsel={r.data.gorsel} baslik={r.data.baslik} aciklama={r.data.aciklama} kategori={r.data.kategori} tarih={r.data.guncelleme ?? r.data.yayin} />)}</div>
  </div>
</Base>
