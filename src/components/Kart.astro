---
import Kapak from './Kapak.astro';
import { KATEGORI_BILGI, type Kategori } from '../content.config';
import { tarihYaz, isoGun } from '../lib/site';
interface Props { slug: string; baslik: string; aciklama?: string; kategori: Kategori; tarih: Date; tur?: 'buyuk' | 'normal' | 'yatay' }
const { slug, baslik, aciklama, kategori, tarih, tur = 'normal' } = Astro.props;
const { kisa, renk } = KATEGORI_BILGI[kategori];
---
<article class={`kart kart-${tur}`}>
  <a href={`/rehber/${slug}/`} class="kart-gorsel" tabindex="-1" aria-hidden="true"><Kapak kategori={kategori} slug={slug} buyuk={tur === 'buyuk'} /></a>
  <div class="kart-metin">
    <a href={`/kategori/${kategori}/`} class="kat-etiket" style={`--kat:${renk}`}>{kisa}</a>
    <h3><a href={`/rehber/${slug}/`}>{baslik}</a></h3>
    {aciklama && tur !== 'yatay' && <p>{aciklama}</p>}
    <time datetime={isoGun(tarih)}>{tarihYaz(tarih)}</time>
  </div>
</article>
