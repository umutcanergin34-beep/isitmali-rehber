---
// Yazının kendi cihaz fotoğrafı varsa o gösterilir; yoksa kategorinin açık tonunda, ince noktalı zemin üstünde kategori ikonu çizilir
// oncelikli: sayfanın LCP görseli (rehber kapağı) → fetchpriority=high. yer: büyük kapağın yerleşimi, sizes buna göre hesaplanır
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ikon from './Ikon.astro';
import { KATEGORI_BILGI, type Kategori } from '../content.config';
interface Props { kategori: Kategori; buyuk?: boolean; oncelikli?: boolean; yer?: 'yazi' | 'manset'; gorsel?: { src: ImageMetadata; alt: string } }
const { kategori, buyuk = false, oncelikli = false, yer = 'yazi', gorsel } = Astro.props;
const { renk, kisa } = KATEGORI_BILGI[kategori];
const sinif = buyuk ? 'kapak kapak-buyuk' : 'kapak';

// sizes = görselin ekrandaki gerçek genişliği. .kap en fazla 72rem, yan boşluk 16px (<48rem) / 32px.
// Büyük kapak 16:9 kutuda object-fit: contain ile durur: 16:9'dan dar (dik/kare) fotoğraf kutunun yalnızca bir kısmını kaplar
const oran = gorsel ? Math.min(1, gorsel.src.width / gorsel.src.height / (16 / 9)) : 1;
const k = (u: string) => (oran < 1 ? `calc((${u}) * ${oran.toFixed(3)})` : u.includes(' ') ? `calc(${u})` : u);
const BUYUK = {
  yazi: [['(min-width: 64rem)', '704px'], ['(min-width: 48rem)', '100vw - 64px'], ['', '100vw - 32px']],
  manset: [['(min-width: 72rem)', '640px'], ['(min-width: 60rem)', '61.5vw - 69px'], ['(min-width: 48rem)', '100vw - 64px'], ['', '100vw - 32px']],
};
const sizes = buyuk
  ? BUYUK[yer].map(([m, u]) => `${m} ${k(u)}`.trim()).join(', ')
  // kart ızgarası: 19rem'lik sütunlar, 20px aralık; kart görseli kartın tam genişliğinde
  : '(min-width: 72rem) 350px, (min-width: 63.5rem) calc((100vw - 104px) / 3), (min-width: 48rem) calc((100vw - 84px) / 2), (min-width: 41.25rem) calc((100vw - 52px) / 2), calc(100vw - 32px)';
---
{gorsel ? (
  <Picture src={gorsel.src} alt={gorsel.alt} class={`${sinif} kapak-foto`} formats={['avif']} fallbackFormat="webp"
    widths={buyuk ? [480, 720, 960, 1280] : [400, 640]} sizes={sizes}
    loading={buyuk ? 'eager' : 'lazy'} fetchpriority={oncelikli ? 'high' : undefined} />
) : (
  <div class={`${sinif} kapak-cizim`} style={`--kat:${renk}`} role="img" aria-label={`${kisa} kategorisi`}>
    <span class="kapak-ikon"><Ikon ad={kategori} boyut={buyuk ? 56 : 40} /></span>
    <span class="kapak-etiket">{kisa}</span>
  </div>
)}
