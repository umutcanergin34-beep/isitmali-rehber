---
// Ürün fotoğrafı kullanmadığımız için her yazıya kategorisinin renginde, slug'dan türeyen soyut bir kapak çizilir
import { KATEGORI_BILGI, type Kategori } from '../content.config';
interface Props { kategori: Kategori; slug: string; buyuk?: boolean }
const { kategori, slug, buyuk = false } = Astro.props;
const { renk, kisa } = KATEGORI_BILGI[kategori];
// slug'dan sabit bir sayı: aynı yazı her derlemede aynı kapağı alır
let tohum = 0;
for (const c of slug) tohum = (tohum * 31 + c.charCodeAt(0)) >>> 0;
const r = (n: number) => { tohum = (tohum * 1103515245 + 12345) >>> 0; return tohum % n; };
const halkalar = Array.from({ length: 4 }, (_, i) => ({ cx: 120 + r(360), cy: 40 + r(200), rr: 30 + r(90) + i * 10 }));
const aci = r(30) - 15;
---
<svg class={buyuk ? 'kapak kapak-buyuk' : 'kapak'} viewBox="0 0 640 360" role="img" aria-label={`${kisa} kategorisi kapak görseli`} preserveAspectRatio="xMidYMid slice">
  <rect width="640" height="360" fill={renk} />
  <g fill="none" stroke="#ffffff" stroke-opacity="0.16" stroke-width="2">
    {halkalar.map((h) => <circle cx={h.cx} cy={h.cy} r={h.rr} />)}
  </g>
  {/* Soyut cihaz ve ısı dalgası: ürün ya da duman görseli kullanılmaz */}
  <g transform={`rotate(${aci} 470 190)`} fill="none" stroke="#ffffff" stroke-linecap="round">
    <rect x="420" y="70" width="96" height="220" rx="40" stroke-width="6" stroke-opacity="0.9" />
    <rect x="446" y="100" width="44" height="60" rx="18" stroke-width="4" stroke-opacity="0.6" />
    <path d="M540 120q18 20 0 40t0 40t0 40" stroke-width="5" stroke-opacity="0.55" />
    <path d="M566 110q18 20 0 40t0 40t0 40t0 40" stroke-width="4" stroke-opacity="0.35" />
  </g>
  <text x="32" y="324" fill="#ffffff" font-family="ui-sans-serif, system-ui, sans-serif" font-size="22" font-weight="700" letter-spacing="2">{kisa.toLocaleUpperCase('tr-TR')}</text>
</svg>
