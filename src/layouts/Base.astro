---
import '../styles/global.css';
// Latin yazı tipi dosyaları HTML ile birlikte istensin: geç gelince giriş başlığı yeniden kırılıp alttaki kutuyu kaydırıyor (Lighthouse CLS 0.15).
// ?url, CSS'teki @font-face ile aynı hash'li dosyayı verir
import interLatin from '../assets/fonts/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_ADI, SITE_URL, YAYINDA } from '../lib/site';
import { yayinciSemasi } from '../lib/sema';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // false: canonical ve og:url basılmaz (404 her adreste sunulur)
  canonical?: boolean;
  jsonLd?: Record<string, unknown>[];
  ogTur?: 'website' | 'article';
  yayin?: Date;
  guncelleme?: Date;
  // Paylaşım görseli: mutlak ya da kök-göreli URL, 1200 px genişlikte
  ogGorsel?: { src: string; width: number; height: number; alt: string };
}
const { title, description, noindex = false, canonical: canonicalVar = true, jsonLd = [], ogTur = 'website', yayin, guncelleme, ogGorsel } = Astro.props;
const yol = Astro.url.pathname;
const canonical = new URL(yol, SITE_URL).href;
// Arama sonucunda ~60 karakterden sonrası kesilir; uzun başlıkta site adı eklenmez
const ekli = `${title} | ${SITE_ADI}`;
const tamBaslik = ekli.length > 60 ? title : ekli;
const kapali = noindex || !YAYINDA;
---
<!doctype html>
<html lang="tr-TR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tamBaslik}</title>
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {canonicalVar && <link rel="canonical" href={canonical} />}
    {kapali
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta property="og:type" content={ogTur} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={description} />
    {canonicalVar && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_ADI} />
    <meta property="og:locale" content="tr_TR" />
    {yayin && <meta property="article:published_time" content={yayin.toISOString()} />}
    {(guncelleme ?? yayin) && <meta property="article:modified_time" content={(guncelleme ?? yayin)!.toISOString()} />}
    {ogGorsel && <meta property="og:image" content={new URL(ogGorsel.src, SITE_URL).href} />}
    {ogGorsel && <meta property="og:image:width" content={String(ogGorsel.width)} />}
    {ogGorsel && <meta property="og:image:height" content={String(ogGorsel.height)} />}
    {ogGorsel && <meta property="og:image:alt" content={ogGorsel.alt} />}
    <meta name="twitter:card" content={ogGorsel ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#15201e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_ADI} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(yayinciSemasi())} />
    {jsonLd.map((veri) => <script type="application/ld+json" set:html={JSON.stringify(veri)} />)}
  </head>
  <body>
    <a href="#icerik" class="gizli">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
  </body>
</html>
